<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing leaves the device through cloud backup or device-to-
  device transfer. allowBackup="false" alone does not stop device transfer.
  The token itself is Keystore-bound and would not decrypt elsewhere, but
  History, templates and cached account data live in WebView storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
