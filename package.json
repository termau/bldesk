{
  "name": "bldesk",
  "version": "1.0.61-beta.2",
  "type": "module",
  "description": "BinaryLane Cloud Desktop Client",
  "main": "./out/main/index.js",
  "author": {
    "name": "termau",
    "email": "support@binarylane.com.au"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint:guards": "node scripts/check-mutation-guards.mjs && node scripts/check-ui-guards.mjs && node scripts/check-help-guards.mjs && node scripts/check-pty-guards.mjs",
    "test:terminal": "node scripts/test-terminal.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run lint:guards",
    "generate-api": "openapi-typescript ./openapi.json -o ./src/shared/api/schema.d.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run generate-api && electron-vite build",
    "cap:sync": "npm run build && npx cap sync android",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "appId": "com.termau.bldesk",
    "afterPack": "scripts/after-pack.cjs",
    "productName": "BLDesk",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "termau",
      "repo": "bldesk",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "BLDesk",
        "schemes": [
          "bldesk"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "nsis/installer.nsh"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "afterInstall": "linux/after-install.sh",
      "afterRemove": "linux/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tanstack/react-query": "^5.60.5",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.460.0",
    "node-pty": "1.1.0",
    "openapi-fetch": "^0.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "openapi-typescript": "^7.4.3",
    "postcss": "^8.4.47",
    "ssh2": "1.17.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "overrides": {
    "@electron/rebuild": "3.7.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
